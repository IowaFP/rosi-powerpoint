{
  "name": "rosi-vscode",
  "publisher": "clc-iowa",
  "displayName": "Rosi",
  "description": "Rosi language support for vscode",
  "version": "0.3.0",
  "repository": "https://github.com/IowaFP/rosi-vscode",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "publish-ext": "npx vsce login clc-iowa ; npx vsce package && npx vsce publish"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rosi",
        "aliases": [
          "Rosi",
          "rosi"
        ],
        "extensions": [
          ".ro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rosi",
        "scopeName": "source.rosi",
        "path": "./syntaxes/rosi.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "rosi-vscode.enableUnicodeInputUser",
        "title": "Enable Unicode Input (User)",
        "category": "Rosi"
      },
      {
        "command": "rosi-vscode.enableUnicodeInputWorkspace",
        "title": "Enable Unicode Input (Workspace)",
        "category": "Rosi"
      }
    ]
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.144.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
