{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "rosi",
  "patterns": [
    { "include": "#comments" },
    { "include": "#types" },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#labels"
    },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.rosi",
          "match": "\\b(forall|exists|row|type|import|let|in|∀|∃)\\b"
        } 
      ]
    },
    "strings": {
      "name": "string.quoted.double.rosi",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.rosi",
          "match": "\\\\."
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.rosi",
          "begin": "{-",
          "end": "-}"
        },
        {
          "name": "comment.line.rosi",
          "begin": "--",
          "end": "\n"
        }
      ]
    },
    "types": {
      "patterns": [
        { 
          "match": "(#'?\\w+?)\\b", 
          "name": "string.quoted.unquoted.other.rosi"
        },
        {
          "match": "\\b((?![R\\[])[A-Z]\\w*)|⊤|⊥\\b",
          "name": "entity.name.type.rosi"
        }]
    },
    "labels": {
      "patterns": [
        {
          "name": "string.quoted.unquoted.other.rosi",
          "match": "\\B(\\'\\w+)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.rosi",
          "match": "\\b(Pi|Sigma|Mu|Π|Σ|μ)\\b"
        },
        {
          "name": "constant.numeric.rosi",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }        
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rosi",
          "match": "[▹⇒→∖\\!\\$\\%\\&\\;\\+\\.\\/\\<\\>\\=\\?\\@\\^\\|\\-\\~\\*\\:\\\\]+"
        },
        { "name": "keyword.operator.new.rosi", "match": "\\b(prj|inj|fix|×|\\+|\\?|\\$)\\b" },
        { "name": "keyword.operator.prefix.rosi", "match": "\\Λ|λ" }
      ]
    }
  },
  "scopeName": "source.rosi"
}
